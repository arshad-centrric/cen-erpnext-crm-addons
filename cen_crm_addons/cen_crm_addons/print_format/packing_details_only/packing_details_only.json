 "html": "<style>\n    @page { size: 4in 6in; margin: 0; }\n\n    .print-format-custom {\n        padding: 2mm 4mm;\n        box-sizing: border-box;\n    }\n\n    /* Fixed label height: this is what makes it fill the sticker in every mode */\n    .label-container {\n        border: 4px solid #000;\n        border-radius: 8px;\n        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n        color: #000;\n        margin: 0 auto;\n        width: 100%;\n        height: 143mm;\n        box-sizing: border-box;\n        background-color: #fff;\n        overflow: hidden;\n    }\n\n    .layout {\n        width: 100%;\n        height: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n    }\n    .layout td { padding: 0; vertical-align: top; }\n    .row-fit { height: 1px; }           /* row shrinks to its content */\n    .row-line { border-top: 2px solid #000; }\n\n    .top-section { padding: 12px 16px !important; }\n    .box-id-title {\n        font-size: 34px;\n        font-weight: 900;\n        letter-spacing: 1px;\n        margin-bottom: 8px;\n    }\n    .contact-lines {\n        font-size: 16px;\n        font-weight: bold;\n        line-height: 1.5;\n    }\n\n    .addr-section { padding: 10px 16px !important; }\n    .addr-label {\n        font-size: 12px;\n        color: #555;\n        text-transform: uppercase;\n        font-weight: bold;\n        margin-bottom: 4px;\n    }\n    .addr-text {\n        font-size: 15px;\n        font-weight: bold;\n        line-height: 1.35;\n        word-wrap: break-word;\n        overflow-wrap: break-word;\n    }\n    .contact-block { margin-top: 8px; }\n    .contact-value { font-size: 16px; font-weight: 900; }\n\n    .qr-cell {\n        text-align: center;\n        vertical-align: middle !important;\n        padding: 8px 16px !important;\n    }\n    .order-number-text {\n        font-size: 20px;\n        font-weight: bold;\n        letter-spacing: 2px;\n        margin-top: 6px;\n    }\n</style>\n\n<div class=\"print-format-custom\">\n\n    {% set mode = doc.custom_mode_of_delivery %}\n    {% set show_addr = mode == 'Courier' and (doc.custom_address_line_1 or doc.custom_delivery_city or doc.custom_delivery_state) %}\n    {% set show_contact = mode in ['Courier', 'Home Delivery'] %}\n    {% set dc = doc.custom_delivery_contact if doc.custom_delivery_contact and doc.custom_delivery_contact != 'None' else None %}\n    {% set contact_label = 'Delivery Contact:' if dc else 'Phone:' %}\n    {% set contact_val = dc or doc.contact_mobile or doc.contact_display or 'N/A' %}\n\n    {# QR size depends on how much space the address section uses #}\n    {% if show_addr %}{% set qr = 175 %}{% elif show_contact %}{% set qr = 230 %}{% else %}{% set qr = 260 %}{% endif %}\n\n    {% set city_state = [doc.custom_delivery_city, doc.custom_delivery_state] | select | reject('equalto', 'None') | list %}\n    {% set pin_country = [doc.custom_pincode, doc.custom_delivery_country] | select | reject('equalto', 'None') | list %}\n\n    <div class=\"label-container\">\n        <table class=\"layout\">\n\n            <tr class=\"row-fit\">\n                <td class=\"top-section\">\n                    <div class=\"box-id-title\">{{ doc.custom_box_id or 'NO BOX ID' }}</div>\n                    <div class=\"contact-lines\">\n                        Delivery Mode: {{ mode or 'N/A' }}<br>\n                        Date &amp; Time: {{ doc.get_formatted(\"delivery_date\") if doc.delivery_date else 'N/A' }}{% if doc.custom_delivery_time %}{% set t = (doc.custom_delivery_time | string).split(':') %}{% set h = t[0] | int %}, {{ '%d:%s %s' | format((h % 12) or 12, t[1], 'AM' if h < 12 else 'PM') }}{% endif %}\n                    </div>\n                </td>\n            </tr>\n\n            {% if show_addr or show_contact %}\n            <tr class=\"row-fit\">\n                <td class=\"row-line addr-section\">\n                    {% if show_addr %}\n                        <div class=\"addr-label\">Address:</div>\n                        <div class=\"addr-text\">\n                            {% if doc.custom_address_line_1 and doc.custom_address_line_1 != 'None' %}{{ doc.custom_address_line_1 }}<br>{% endif %}\n                            {% if doc.custom_address_line_2 and doc.custom_address_line_2 != 'None' %}{{ doc.custom_address_line_2 }}<br>{% endif %}\n                            {% if city_state %}{{ city_state | join(', ') }}<br>{% endif %}\n                            {% if pin_country %}{{ pin_country | join(', ') }}{% endif %}\n                        </div>\n                    {% endif %}\n                    {% if show_contact %}\n                        <div class=\"{% if show_addr %}contact-block{% endif %}\">\n                            <div class=\"addr-label\">{{ contact_label }}</div>\n                            <div class=\"contact-value\">{{ contact_val }}</div>\n                        </div>\n                    {% endif %}\n                </td>\n            </tr>\n            {% endif %}\n\n            <tr>\n                <td class=\"row-line qr-cell\">\n                    <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={{ doc.name | urlencode }}\" alt=\"QR Code\" style=\"width: {{ qr }}px; height: {{ qr }}px;\">\n                    <div class=\"order-number-text\">{{ doc.name }}</div>\n                </td>\n            </tr>\n\n        </table>\n    </div>\n</div>",
