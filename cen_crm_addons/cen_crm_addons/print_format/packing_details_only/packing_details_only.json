 "html": "<style>\n    /* Main Container - Thick Border like the reference */\n    .label-container {\n        border: 4px solid #000;\n        border-radius: 8px;\n        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n        color: #000;\n        margin: 0 auto;\n        width: 100%;\n        box-sizing: border-box;\n        background-color: #fff;\n    }\n    \n    /* Global Reset for P tags inside label */\n    .label-container p { margin: 0; padding: 0; }\n\n    /* Divider Lines */\n    .divider-solid {\n        border-top: 2px solid #000;\n        width: 100%;\n    }\n\n    /* --- SECTION 1: Header --- */\n    .header-table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n    .header-table td {\n        padding: 20px;\n        vertical-align: middle; \n    }\n    .sender-name {\n        font-weight: 900;\n        font-size: 20px; \n        text-transform: uppercase;\n        letter-spacing: 0.5px;\n    }\n    .logo-container {\n        text-align: right;\n    }\n    .logo-img {\n        max-height: 50px;\n        object-fit: contain;\n    }\n\n    /* --- SECTION 2: Recipient --- */\n    .recipient-section {\n        padding: 25px 20px;\n    }\n    .recipient-name {\n        font-size: 32px;\n        font-weight: 900;\n        margin-bottom: 15px;\n        letter-spacing: 0.5px;\n    }\n    .recipient-address {\n        font-size: 18px;\n        font-weight: bold;\n        line-height: 1.6;\n    }\n\n    /* --- SECTION 3: Meta Data (3 Columns) --- */\n    .meta-table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n    .meta-table td {\n        padding: 15px 20px;\n        vertical-align: top;\n        border-right: 2px solid #000;\n        width: 33.33%;\n    }\n    .meta-table td:last-child {\n        border-right: none;\n    }\n    .meta-label {\n        font-size: 14px;\n        font-weight: bold;\n        margin-bottom: 12px;\n    }\n    .meta-value {\n        font-size: 18px;\n        font-weight: 900;\n    }\n\n    /* --- SECTION 4: QR Code & Footer --- */\n    .qr-section {\n        text-align: center;\n        padding: 30px 20px;\n    }\n    .qr-img {\n        width: 220px;\n        height: 220px;\n    }\n    .order-number-text {\n        font-size: 24px;\n        font-weight: bold;\n        letter-spacing: 2px;\n        margin-top: 10px;\n    }\n</style>\n\n<div class=\"print-format-custom\">\n    {% set cmp = frappe.get_doc(\"Company\", doc.company) %}\n    \n    <div class=\"label-container\">\n        \n        <table class=\"header-table\">\n            <tr>\n                <td width=\"60%\">\n                    <div class=\"sender-name\">{{ cmp.company_name }}</div>\n                </td>\n                <td width=\"40%\" class=\"logo-container\">\n                    {% if cmp.company_logo %}\n                        <img class=\"logo-img\" src=\"{{ frappe.utils.get_url(cmp.company_logo) }}\" alt=\"Company Logo\">\n                    {% endif %}\n                </td>\n            </tr>\n        </table>\n\n        <div class=\"divider-solid\"></div>\n\n        <div class=\"recipient-section\">\n            <div class=\"recipient-name\">{{ doc.customer_name }}</div>\n            <div class=\"recipient-address\">\n                ID: {{ doc.customer }}<br>\n                Phone: {{ doc.contact_mobile or doc.contact_display or 'N/A' }}<br>\n                Delivery Store: {{ doc.set_warehouse or 'N/A' }}\n                \n                {% if doc.custom_mode_of_delivery == 'Courier' and (doc.custom_address_line_1 or doc.custom_delivery_city or doc.custom_delivery_state) %}\n                    <div style=\"margin-top: 15px; padding-top: 15px; border-top: 2px dashed #000;\">\n                        <div style=\"font-size: 14px; color: #555; text-transform: uppercase; margin-bottom: 5px;\">Address:</div>\n                        <div style=\"font-size: 20px; line-height: 1.4;\">\n                            {% if doc.custom_address_line_1 %}{{ doc.custom_address_line_1 }}<br>{% endif %}\n                            {% if doc.custom_address_line_2 %}{{ doc.custom_address_line_2 }}<br>{% endif %}\n                            {% if doc.custom_delivery_city or doc.custom_delivery_state %}{{ doc.custom_delivery_city }}{% if doc.custom_delivery_city and doc.custom_delivery_state %}, {% endif %}{{ doc.custom_delivery_state }}<br>{% endif %}\n                            {% if doc.custom_pincode or doc.custom_delivery_country %}{{ doc.custom_pincode }}{% if doc.custom_pincode and doc.custom_delivery_country %}, {% endif %}{{ doc.custom_delivery_country }}{% endif %}\n                        </div>\n                    </div>\n                {% endif %}\n            </div>\n        </div>\n\n        <div class=\"divider-solid\"></div>\n\n        <table class=\"meta-table\">\n            <tr>\n                <td>\n                    {% if doc.custom_box_id %}\n                    <div class=\"meta-label\">Box ID:</div>\n                    <div class=\"meta-value\" style=\"font-size: 22px; margin-bottom: 15px;\">{{ doc.custom_box_id }}</div>\n                    {% endif %}\n                    <div class=\"meta-label\">Order No:</div>\n                    <div class=\"meta-value\">{{ doc.name }}</div>\n                </td>\n                <td>\n                    <div class=\"meta-label\">Delivery Mode:</div>\n                    <div class=\"meta-value\">{{ doc.custom_mode_of_delivery or 'N/A' }}</div>\n                    \n                    {% if doc.custom_mode_of_delivery == 'Courier' and doc.custom_delivery_partner %}\n                        {% set p_name = frappe.db.get_value(\"Delivery Partner\", doc.custom_delivery_partner, \"partner_name\") or doc.custom_delivery_partner %}\n                        <div class=\"meta-label\" style=\"margin-top: 15px;\">Courier Partner:</div>\n                        <div class=\"meta-value\" style=\"font-size: 16px;\">{{ p_name }}</div>\n                    {% endif %}\n                </td>\n                <td>\n                    <div class=\"meta-label\">Date & Time:</div>\n                    <div class=\"meta-value\">\n                        {{ doc.get_formatted(\"delivery_date\") }}<br>\n                        {{ (doc.custom_delivery_time | string)[:5] if doc.custom_delivery_time else 'N/A' }}\n                    </div>\n                </td>\n            </tr>\n        </table>\n\n        <div class=\"divider-solid\"></div>\n\n        <div class=\"qr-section\">\n            <img class=\"qr-img\" src=\"https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={{ doc.name | urlencode }}\" alt=\"QR Code\">\n            <div class=\"order-number-text\">{{ doc.name }}</div>\n        </div>\n        \n    </div>\n</div>",
