 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    /* Base Typography & Layout */\n    .print-format-custom {\n        font-family: inherit;\n        font-size: 11px;\n        color: #000;\n    }\n    .print-format-custom p, .print-format-custom h3, .print-format-custom h4 {\n        margin-top: 0;\n    }\n    \n    /* Header Styles */\n    .pf-header {\n        margin-bottom: 15px;\n        border-bottom: 2px solid #000; \n        padding-bottom: 5px; \n        margin-left: 0; \n        margin-right: 0;\n    }\n    .company-name {\n        margin-bottom: 0px; \n        font-weight: bold;\n        font-size: 18px; \n        text-transform: uppercase;\n        line-height: 1;\n    }\n    \n    /* Document Title */\n    .document-title {\n        margin-bottom: 15px;\n        font-weight: 900; \n        letter-spacing: 3px; \n        font-size: 20px;\n        text-align: center;\n        text-transform: uppercase;\n    }\n\n    /* Meta Info Box - 3 COLUMNS */\n    .meta-section {\n        margin-bottom: 10px;\n        border: 1px solid #000 !important;\n        padding: 5px 10px;\n        border-radius: 2px;\n        overflow: hidden; \n    }\n    .meta-label {\n        font-size: 13px; \n        font-weight: bold; \n        text-transform: uppercase;\n    }\n    \n    /* QR Code Wrapper */\n    .qr-wrapper {\n        text-align: right;\n    }\n\n    /* Tear-off Line - UPDATED (Line Only) */\n    .tear-line {\n        border-top: 2px dashed #666;\n        margin: 15px 0 20px 0;\n    }\n\n    /* Packing Instructions Box */\n    .packing-instructions-box {\n        margin-bottom: 15px;\n        border: 2px solid #000;\n        padding: 10px;\n        background-color: #fcfcfc;\n    }\n    .packing-instructions-title {\n        font-size: 11px; \n        font-weight: 900; \n        text-transform: uppercase; \n        margin-bottom: 5px;\n        display: inline-block;\n        border-bottom: 1px solid #000;\n    }\n    .packing-instructions-content {\n        font-size: 13px; \n        font-weight: bold; \n        line-height: 1.4;\n    }\n\n    /* Table Styles - CONDENSED */\n    .print-format-custom .table {\n        margin-bottom: 15px;\n        border-collapse: collapse;\n        width: 100%;\n    }\n    .print-format-custom .table td, \n    .print-format-custom .table th {\n        padding: 4px 6px; \n        vertical-align: middle;\n        font-size: 11px;\n        border: 1px solid #000 !important; \n    }\n    .print-format-custom .table th {\n        background-color: #f5f5f5 !important; \n        font-weight: bold !important;\n        text-transform: uppercase;\n        text-align: center;\n    }\n    \n    .item-name {\n        font-size: 11px;\n        font-weight: bold;\n    }\n    .item-code {\n        font-size: 9px; \n        color: #444;\n    }\n    \n    /* Combo Indicator */\n    .combo-badge {\n        font-size: 9px; \n        color: #d9534f; \n        border: 1px solid #d9534f; \n        padding: 1px 4px; \n        border-radius: 2px;\n        margin-left: 5px;\n        vertical-align: middle;\n    }\n\n    /* Warehouse Component Adjustments */\n    .delta-section {\n        margin-top: 5px;\n        padding: 6px 8px;\n        background-color: #fafbfc;\n        border-left: 3px solid #555;\n    }\n    .delta-title-cancel {\n        font-size: 9px;\n        font-weight: bold;\n        color: #c62828;\n        text-transform: uppercase;\n        margin-bottom: 2px;\n        letter-spacing: 0.5px;\n    }\n    .delta-title-add {\n        font-size: 9px;\n        font-weight: bold;\n        color: #2e7d32;\n        text-transform: uppercase;\n        margin-bottom: 2px;\n        letter-spacing: 0.5px;\n    }\n    .delta-item {\n        font-size: 9.5px;\n        color: #111;\n        padding-left: 4px;\n        line-height: 1.3;\n    }\n</style>\n\n<div class=\"print-format-custom\">\n    {% set cmp = frappe.get_doc(\"Company\", doc.company) %}\n    \n    {% set delivery_item_code = frappe.db.get_single_value('Cen CRM Settings', 'delivery_charge_item') %}\n    \n    <div class=\"row pf-header\">\n        <div class=\"col-xs-8\" style=\"padding-top: 20px;\">\n            <h3 class=\"company-name\">{{ cmp.company_name }}</h3>\n        </div>\n        <div class=\"col-xs-4 text-right\">\n            {% if cmp.company_logo %}\n               <img src=\"{{ cmp.company_logo }}\" style=\"max-height: 70px; object-fit: contain;\">\n            {% endif %}\n        </div>\n    </div>\n    \n    <div class=\"document-title\">\n        SALES INVOICE\n    </div>\n    \n    <div class=\"meta-section\">\n        <div class=\"row\" style=\"margin: 0;\">\n            <div class=\"col-xs-4\" style=\"padding-left: 0;\">\n                <div style=\"margin-bottom: 2px;\">\n                    <span style=\"color: #333;\">Customer:</span><br>\n                    <span class=\"meta-label\">{{ doc.customer_name }}</span><br>\n                    <span style=\"font-size: 11.5px; color: #444; font-weight: bold;\">ID: {{ doc.customer }}</span><br>\n                    <span style=\"font-size: 11.5px; color: #444; font-weight: bold;\">Phone: {{ doc.contact_mobile or doc.contact_display or 'N/A' }}</span>\n                </div>\n                \n                {% if doc.custom_mode_of_delivery == 'Courier' and (doc.custom_address_line_1 or doc.custom_delivery_city or doc.custom_delivery_state) %}\n                <div style=\"margin-top: 4px; padding-top: 3px; border-top: 1px dotted #ccc;\">\n                    <span style=\"color: #555; font-size: 9px; text-transform: uppercase; font-weight: bold;\">Address:</span><br>\n                    <span style=\"font-size: 11px; font-weight: bold; line-height: 1.3;\">\n                        {% if doc.custom_address_line_1 %}{{ doc.custom_address_line_1 }}<br>{% endif %}\n                        {% if doc.custom_address_line_2 %}{{ doc.custom_address_line_2 }}<br>{% endif %}\n                        {% if doc.custom_delivery_city or doc.custom_delivery_state %}{{ doc.custom_delivery_city }}{% if doc.custom_delivery_city and doc.custom_delivery_state %}, {% endif %}{{ doc.custom_delivery_state }}<br>{% endif %}\n                        {% if doc.custom_pincode or doc.custom_delivery_country %}{{ doc.custom_pincode }}{% if doc.custom_pincode and doc.custom_delivery_country %}, {% endif %}{{ doc.custom_delivery_country }}{% endif %}\n                    </span>\n                </div>\n                {% endif %}\n            </div>\n            \n            <div class=\"col-xs-5\">\n                <div style=\"margin-bottom: 5px;\">\n                    <span style=\"color: #333;\">Date & Time:</span>\n                    <span style=\"font-size: 12px; font-weight: bold; margin-left: 5px;\">{{ doc.get_formatted(\"posting_date\") }} | {{ (doc.posting_time | string)[:5] if doc.posting_time else 'N/A' }}</span>\n                </div>\n                \n                {% if doc.custom_box_id %}\n                <div style=\"margin-bottom: 5px;\">\n                    <span style=\"color: #333;\">BOX ID:</span>\n                    <span style=\"font-size: 12px; font-weight: bold; margin-left: 5px;\">{{ doc.custom_box_id }}</span>\n                </div>\n                {% endif %}\n                \n                <div>\n                    <span style=\"color: #333;\">Invoice ID:</span>\n                    <span style=\"font-size: 12px; font-weight: bold; margin-left: 5px;\">{{ doc.name }}</span>\n                </div>\n            </div>\n\n            <div class=\"col-xs-3 qr-wrapper\" style=\"padding-right: 0;\">\n                <div style=\"color: #333; margin-bottom: 3px; font-size: 10px;\">Scan to Verify:</div>\n                <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={{ doc.name | urlencode }}\" style=\"height: 70px; width: 70px; border: 1px solid #000; padding: 2px;\" alt=\"QR Code\">\n            </div>\n            \n        </div>\n    </div>\n    \n    <div class=\"tear-line\"></div>\n\n    {% if doc.custom_packing_instructions %}\n    <div class=\"packing-instructions-box\">\n        <div class=\"packing-instructions-title\">Special Packing Instructions</div>\n        <div class=\"packing-instructions-content\">\n            {{ doc.custom_packing_instructions | replace('\\n', '<br>') }}\n        </div>\n    </div>\n    {% endif %}\n    \n    <table class=\"table\">\n        <thead>\n            <tr>\n                <th width=\"5%\">SR</th>\n                <th width=\"45%\" style=\"text-align: left;\">ITEM DESCRIPTION</th>\n                <th width=\"10%\" class=\"text-center\">QTY</th>\n                <th width=\"10%\" class=\"text-center\">UOM</th>\n                <th width=\"15%\" class=\"text-right\">RATE</th>\n                <th width=\"15%\" class=\"text-right\">AMOUNT</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.items if row.item_code != delivery_item_code %}\n                <tr>\n                    <td class=\"text-center\" style=\"font-weight: bold;\">{{ loop.index }}</td>\n                    <td>\n                        <span class=\"item-name\">{{ row.item_name }}</span>\n                        {% if row.custom_is_customized_bundle %}\n                            <span class=\"combo-badge\">CUSTOM BUNDLE</span>\n                        {% endif %}\n                        \n                        {% if row.item_code != row.item_name %}\n                        <br><span class=\"item-code\">Code: {{ row.item_code }}</span>\n                        {% endif %}\n                        {% if row.description and row.description != row.item_name %}\n                        <br><span style=\"font-size: 9px; color: #555;\">{{ row.description | striptags }}</span>\n                        {% endif %}\n\n                        {% if row.custom_is_customized_bundle and row.custom_original_bundle_item %}\n                            {% set base_items_raw = frappe.get_all(\"Product Bundle Item\", filters={\"parent\": row.custom_original_bundle_item}, fields=[\"item_code\", \"qty\"]) %}\n                            {% set custom_items_raw = frappe.get_all(\"Product Bundle Item\", filters={\"parent\": row.item_code}, fields=[\"item_code\", \"qty\"]) %}\n                            \n                            {% set base_map = {} %}\n                            {% for b in base_items_raw %}\n                                {% set _ = base_map.update({b.item_code: b.qty}) %}\n                            {% endfor %}\n                            \n                            {% set custom_map = {} %}\n                            {% for c in custom_items_raw %}\n                                {% set _ = custom_map.update({c.item_code: c.qty}) %}\n                            {% endfor %}\n                            \n                            {% set all_keys = [] %}\n                            {% for k in base_map.keys() %}{% set _ = all_keys.append(k) %}{% endfor %}\n                            {% for k in custom_map.keys() %}{% if k not in all_keys %}{% set _ = all_keys.append(k) %}{% endif %}{% endfor %}\n                            \n                            {% set additions = [] %}\n                            {% set cancellations = [] %}\n                            \n                            {% for item in all_keys %}\n                                {% set b_qty = base_map.get(item, 0) | float %}\n                                {% set c_qty = custom_map.get(item, 0) | float %}\n                                {% set diff = c_qty - b_qty %}\n                                \n                                {% set item_name_disp = frappe.db.get_value(\"Item\", item, \"item_name\") or item %}\n                                \n                                {% if diff > 0 %}\n                                    {% set _ = additions.append({\"name\": item_name_disp, \"qty\": diff}) %}\n                                {% elif diff < 0 %}\n                                    {% set _ = cancellations.append({\"name\": item_name_disp, \"qty\": diff | abs}) %}\n                                {% endif %}\n                            {% endfor %}\n                            \n                            {% if additions or cancellations %}\n                            <div class=\"delta-section\">\n                                {% if cancellations %}\n                                    <div class=\"delta-title-cancel\">\u25cf Cancelled</div>\n                                    {% for cancel in cancellations %}\n                                        <div class=\"delta-item\">\u2022 {{ cancel.name }} <b>(-{{ cancel.qty | round(2) }})</b></div>\n                                    {% endfor %}\n                                {% endif %}\n                                \n                                {% if additions %}\n                                    <div class=\"delta-title-add\" style=\"{% if cancellations %}margin-top: 5px;{% endif %}\">\u25cf Added</div>\n                                    {% for add in additions %}\n                                        <div class=\"delta-item\">\u2022 {{ add.name }} <b>(+{{ add.qty | round(2) }})</b></div>\n                                    {% endfor %}\n                                {% endif %}\n                            </div>\n                            {% endif %}\n                        {% endif %}\n                    </td>\n                    <td class=\"text-center\" style=\"font-size: 12px; font-weight: bold;\">\n                        {{ row.qty | round(2) }}\n                    </td>\n                    <td class=\"text-center\" style=\"font-size: 10px; color: #333;\">\n                        {{ row.uom }}\n                    </td>\n                    <td class=\"text-right\" style=\"font-weight: bold;\">\n                        {{ row.get_formatted(\"rate\") }}\n                    </td>\n                    <td class=\"text-right\" style=\"font-weight: bold;\">\n                        {{ row.get_formatted(\"amount\") }}\n                    </td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <!-- TOTALS SUMMARY TABLE -->\n    <div class=\"row\">\n        <div class=\"col-xs-6 col-xs-offset-6\">\n            <table class=\"table\">\n                <tbody>\n                    <tr>\n                        <td style=\"font-weight: bold;\">Net Total</td>\n                        <td class=\"text-right\" style=\"font-weight: bold;\">{{ doc.get_formatted(\"net_total\") }}</td>\n                    </tr>\n                    {% if doc.total_taxes_and_charges %}\n                    <tr>\n                        <td style=\"font-weight: bold;\">Taxes & Charges</td>\n                        <td class=\"text-right\" style=\"font-weight: bold;\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td>\n                    </tr>\n                    {% endif %}\n                    <tr>\n                        <td style=\"font-weight: 900; font-size: 12px;\">Grand Total</td>\n                        <td class=\"text-right\" style=\"font-weight: 900; font-size: 12px;\">{{ doc.get_formatted(\"grand_total\") }}</td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"2\" style=\"font-size: 10px;\">\n                            <span style=\"color: #555;\">In Words:</span> <strong>{{ doc.in_words }}</strong>\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n    </div>\n</div>",
