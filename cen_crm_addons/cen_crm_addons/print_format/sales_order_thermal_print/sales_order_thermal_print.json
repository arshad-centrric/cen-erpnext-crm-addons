 "font_size": 14,
 "html": "<style>\n    /* Print-specific optimizations for Thermal Printers */\n    @media print {\n        @page {\n            size: 80mm auto;\n            margin: 0;\n        }\n        body {\n            margin: 0 !important;\n            padding: 0 !important;\n        }\n        .receipt-container {\n            color: #000000 !important;\n            text-rendering: optimizeLegibility !important;\n            -webkit-font-smoothing: antialiased;\n            margin: 0 auto !important;\n            padding: 0 !important;\n            width: 300px !important;\n            max-width: 300px !important;\n        }\n    }\n\n    .receipt-container {\n        width: 100%;\n        max-width: 300px;\n        font-family: 'Arial', 'Helvetica', sans-serif; \n        font-size: 13px;\n        font-weight: 500;\n        color: #000000;\n        margin: 0 auto;\n        padding: 0;\n    }\n    \n    .text-center { text-align: center; }\n    .text-right { text-align: right; }\n    .text-left { text-align: left; }\n    .bold { font-weight: 700; }\n    \n    .dashed-line {\n        border-bottom: 1px dashed #000;\n        margin: 5px 0;\n    }\n    \n    table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n    \n    th, td {\n        padding: 0 !important; \n        margin: 0 !important;\n        line-height: 1.2 !important; \n    }\n    th { vertical-align: bottom; }\n    td { vertical-align: top; }\n    \n    /* Specific styles for the item table to improve visibility and prevent overlapping */\n    .item-table th, .item-table td {\n        font-size: 11px !important; /* Reduced font size just for items */\n        padding: 2px 0 !important;  /* Slight vertical padding for readability */\n    }\n\n    .totals-table {\n        width: 80%;\n        float: right;\n    }\n    .clear { clear: both; }\n</style>\n\n<div class=\"receipt-container\">\n    <div class=\"text-center bold\" style=\"font-size: 16px;\">{{ doc.company }}</div>\n    \n    <div class=\"text-center\" style=\"font-size: 12px; margin-bottom: 5px;\">\n        Tel: {{ frappe.db.get_value('Company', doc.company, 'phone_no') or 'Your Phone Number' }}\n    </div>\n    \n    <div class=\"text-center bold\" style=\"font-size: 14px; margin-top: 5px;\">Sales Order</div>\n    <div class=\"dashed-line\"></div>\n    \n    <div>\n        <span class=\"bold\">Order#:</span> {{ doc.name }} \n        <span style=\"float: right;\"><span class=\"bold\">Date:</span> {{ doc.get_formatted('transaction_date') }}</span>\n    </div>\n    <div><span class=\"bold\">Party:</span> {{ doc.customer_name or 'Cash' }}</div>\n    \n    <div class=\"dashed-line\"></div>\n    \n    <table class=\"item-table\" cellpadding=\"0\" cellspacing=\"0\" style=\"table-layout: fixed; width: 100%; border-collapse: collapse; border-spacing: 0;\">\n        <tr style=\"border-bottom: 1px dashed #000;\">\n            <!-- Adjusted widths to prevent overlapping -->\n            <th class=\"text-left\" style=\"width: 7%;\">#</th>\n            <th class=\"text-left\" style=\"width: 37%;\">Description</th>\n            <th class=\"text-right\" style=\"width: 14%;\">Qty</th>\n            <th class=\"text-right\" style=\"width: 21%;\">Rate</th>\n            <th class=\"text-right\" style=\"width: 21%;\">Total</th>\n        </tr>\n        \n        {%- for item in doc.items -%}\n        <tr>\n            <td>{{ loop.index }}</td>\n            <td style=\"word-wrap: break-word; padding-right: 2px !important;\">\n                {{ item.item_name }}\n            </td>\n            <td class=\"text-right\">{{ \"{:,.2f}\".format(item.qty) }}</td>\n            <td class=\"text-right\">{{ \"{:,.2f}\".format(item.rate) }}</td>\n            <td class=\"text-right\">{{ \"{:,.2f}\".format(item.amount) }}</td>\n        </tr>\n        {%- endfor -%}\n    </table>\n    \n    <div class=\"dashed-line\"></div>\n    \n    <table class=\"totals-table\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height: 1.2; border-spacing: 0;\">\n        <tr>\n            <td class=\"text-right bold\" style=\"padding: 0 !important; border: none !important;\">Subtotal :</td>\n            <td class=\"text-right\" style=\"padding: 0 !important; border: none !important;\">{{ \"{:,.2f}\".format(doc.total) }}</td>\n        </tr>\n        {%- if doc.discount_amount -%}\n        <tr>\n            <td class=\"text-right bold\" style=\"padding: 0 !important; border: none !important;\">Discount(-) :</td>\n            <td class=\"text-right\" style=\"padding: 0 !important; border: none !important;\">{{ \"{:,.2f}\".format(doc.discount_amount) }}</td>\n        </tr>\n        {%- endif -%}\n        <tr>\n            <td class=\"text-right bold\" style=\"font-size: 15px; padding: 2px 0 !important; border: none !important;\">Grand Total :</td>\n            <td class=\"text-right bold\" style=\"font-size: 15px; padding: 2px 0 !important; border: none !important;\">{{ \"{:,.2f}\".format(doc.grand_total) }}</td>\n        </tr>\n    </table>\n    <div class=\"clear\"></div>\n    \n    <div class=\"dashed-line\"></div>\n    \n    <div class=\"bold\" style=\"margin-top: 8px; font-size: 12px;\">\n        Amt in Words: {{ doc.currency }} {{ doc.in_words }}\n    </div>\n    \n    {% if doc.get('payments') %}\n    <div style=\"margin-top: 5px; font-size: 12px;\">\n        <span class=\"bold\">Pay Mode:</span> \n        {% set pay_strings = [] %}\n        {% for pay in doc.payments %}\n            {% set _ = pay_strings.append(pay.mode_of_payment ~ \" : \" ~ \"{:,.2f}\".format(pay.amount)) %}\n        {% endfor %}\n        {{ pay_strings | join(', ') }}\n    </div>\n    {% endif %}\n    \n    <div style=\"font-size: 12px; margin-top: 5px;\"><span class=\"bold\">Prepared By:</span> {{ doc.owner }}</div>\n    \n    <div class=\"dashed-line\"></div>\n    <div class=\"text-center bold\" style=\"font-size: 13px;\">*** THANK YOU ***</div>\n    <div class=\"dashed-line\"></div>\n</div>",
 "idx": 0,
