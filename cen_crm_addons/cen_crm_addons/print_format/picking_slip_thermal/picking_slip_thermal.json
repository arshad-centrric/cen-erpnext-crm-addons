 "html": "<style>\n    /* Thermal Print Constraints */\n    .thermal-wrapper {\n        width: 100%;\n        max-width: 80mm; /* Standard 3-inch thermal paper */\n        margin: 0 auto;\n        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n        font-size: 12px;\n        color: #000;\n        line-height: 1.3;\n    }\n    \n    .thermal-wrapper p, .thermal-wrapper h2, .thermal-wrapper h3 {\n        margin: 0;\n        padding: 0;\n    }\n\n    /* Header & Titles */\n    .thermal-header {\n        text-align: center;\n        margin-bottom: 10px;\n        border-bottom: 2px dashed #000;\n        padding-bottom: 10px;\n    }\n    .thermal-company {\n        font-size: 18px;\n        font-weight: bold;\n        text-transform: uppercase;\n        margin-bottom: 5px;\n    }\n    .thermal-title {\n        font-size: 16px;\n        font-weight: bold;\n        letter-spacing: 2px;\n    }\n\n    /* Meta Details */\n    .thermal-meta {\n        margin-bottom: 10px;\n        font-size: 12px;\n    }\n    .meta-row {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 3px;\n    }\n\n    /* QR Code */\n    .thermal-qr {\n        text-align: center;\n        margin: 10px 0;\n        padding: 10px 0;\n        border-top: 1px dashed #000;\n        border-bottom: 1px dashed #000;\n    }\n\n    /* Items Table */\n    .thermal-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 15px;\n    }\n    .thermal-table th {\n        text-align: left;\n        border-bottom: 1px solid #000;\n        padding: 4px 0;\n        font-size: 11px;\n        text-transform: uppercase;\n    }\n    .thermal-table td {\n        padding: 5px 0;\n        vertical-align: top;\n        border-bottom: 1px dotted #ccc;\n    }\n    \n    .item-code {\n        font-size: 10px;\n        color: #555;\n    }\n    .bundle-badge {\n        font-size: 9px;\n        background: #000;\n        color: #fff;\n        padding: 1px 3px;\n        border-radius: 2px;\n    }\n</style>\n\n<div class=\"thermal-wrapper\">\n    {% set cmp = frappe.get_doc(\"Company\", doc.company) %}\n    \n    <div class=\"thermal-header\">\n        <div class=\"thermal-company\">{{ cmp.company_name }}</div>\n        <div class=\"thermal-title\">PICKING SLIP</div>\n    </div>\n    \n    <div class=\"thermal-meta\">\n        <div class=\"meta-row\">\n            <span><b>To:</b> {{ doc.customer_name }}</span>\n        </div>\n        <div class=\"meta-row\">\n            <span><b>ID:</b> {{ doc.customer }}</span>\n        </div>\n        <div class=\"meta-row\">\n            <span><b>Store:</b> {{ doc.set_warehouse or 'N/A' }}</span>\n        </div>\n        <div class=\"meta-row\">\n            <span><b>Delivery Date:</b> {{ doc.get_formatted(\"delivery_date\") }}</span>\n        </div>\n    </div>\n    \n    <div class=\"thermal-qr\">\n        <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={{ doc.name | urlencode }}\" style=\"width: 100px; height: 100px;\" alt=\"QR Code\">\n        <div style=\"font-weight: bold; margin-top: 5px; font-size: 14px;\">{{ doc.name }}</div>\n    </div>\n    \n    <table class=\"thermal-table\">\n        <thead>\n            <tr>\n                <th width=\"15%\">SR</th>\n                <th width=\"65%\">ITEM</th>\n                <th width=\"20%\" style=\"text-align: right;\">QTY</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.items %}\n                {% set parent_index = loop.index %}\n                \n                {% set child_items = [] %}\n                {% if doc.packed_items %}\n                    {% for p_item in doc.packed_items %}\n                        {% if p_item.parent_detail_docname == row.name %}\n                            {% set _ = child_items.append(p_item) %}\n                        {% endif %}\n                    {% endfor %}\n                {% endif %}\n                \n                <tr>\n                    <td style=\"font-weight: bold;\">{{ parent_index }}</td>\n                    <td>\n                        <b>{{ row.item_name }}</b>\n                        {% if child_items|length > 0 %}\n                            <span class=\"bundle-badge\">BUNDLE</span>\n                        {% endif %}\n                        {% if row.item_code != row.item_name %}\n                            <br><span class=\"item-code\">{{ row.item_code }}</span>\n                        {% endif %}\n                    </td>\n                    <td style=\"text-align: right; font-weight: bold; font-size: 14px;\">\n                        {{ row.qty | round(2) }}\n                        <div style=\"font-size: 10px; font-weight: normal;\">{{ row.uom }}</div>\n                    </td>\n                </tr>\n                \n                {% if child_items|length > 0 %}\n                    {% for c_item in child_items %}\n                    <tr>\n                        <td style=\"font-size: 11px; padding-left: 5px; color: #444;\">{{ parent_index }}.{{ loop.index }}</td>\n                        <td style=\"padding-left: 5px; font-size: 11px;\">\n                            <span style=\"color: #666;\">&#10551;</span> {{ c_item.item_name }}\n                        </td>\n                        <td style=\"text-align: right; font-size: 11px; font-weight: bold;\">\n                            {{ c_item.qty | round(2) }}\n                            <span style=\"font-size: 9px; font-weight: normal;\">{{ c_item.uom }}</span>\n                        </td>\n                    </tr>\n                    {% endfor %}\n                {% endif %}\n                \n            {% endfor %}\n        </tbody>\n    </table>\n</div>",
