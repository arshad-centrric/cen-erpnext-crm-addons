 "font_size": 14,
 "html": "<style>\n    /* Thermal Print Constraints */\n    .thermal-wrapper {\n        width: 100%;\n        max-width: 80mm; /* Standard 3-inch thermal paper */\n        margin: 0 auto;\n        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n        font-size: 11px; \n        color: #000;\n        line-height: 1.2; \n    }\n    \n    .thermal-wrapper p, .thermal-wrapper h2, .thermal-wrapper h3 {\n        margin: 0;\n        padding: 0;\n    }\n\n    /* Header & Titles */\n    .thermal-header {\n        text-align: center;\n        margin-bottom: 5px;\n        border-bottom: 1px dashed #000;\n        padding-bottom: 5px;\n    }\n    .thermal-company {\n        font-size: 16px;\n        font-weight: bold;\n        text-transform: uppercase;\n        margin-bottom: 2px;\n    }\n    .thermal-title {\n        font-size: 14px;\n        font-weight: bold;\n        letter-spacing: 1px;\n    }\n\n    /* Meta Details - CONDENSED */\n    .thermal-meta {\n        margin-bottom: 5px;\n        font-size: 11px;\n    }\n    .meta-row {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 1px; \n    }\n\n    /* QR Code - ENLARGED FOR SCANNABILITY */\n    .thermal-qr {\n        text-align: center;\n        margin: 8px 0;\n        padding: 8px 0;\n        border-top: 1px dashed #000;\n        border-bottom: 1px dashed #000;\n    }\n\n    /* Special Packing Instructions - THERMAL COMPACT */\n    .thermal-instructions {\n        margin: 5px 0 8px 0;\n        padding: 4px;\n        border: 2px solid #000;\n        text-align: center;\n    }\n    .thermal-instructions-title {\n        font-size: 10px;\n        font-weight: 900;\n        text-transform: uppercase;\n        border-bottom: 1px solid #000;\n        margin-bottom: 3px;\n        display: inline-block;\n        padding-bottom: 1px;\n    }\n    .thermal-instructions-content {\n        font-size: 12px;\n        font-weight: bold;\n        line-height: 1.3;\n    }\n\n    /* Items Table - SUPER COMPACT */\n    .thermal-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 5px;\n    }\n    .thermal-table th {\n        text-align: left;\n        border-bottom: 1px solid #000;\n        padding: 2px 0; \n        font-size: 10px;\n        text-transform: uppercase;\n    }\n    .thermal-table td {\n        padding: 2px 0; \n        vertical-align: top;\n        border-bottom: 1px dotted #ccc;\n    }\n    \n    .item-code {\n        font-size: 9px;\n        color: #555;\n    }\n    .bundle-badge {\n        font-size: 8px;\n        background: #000;\n        color: #fff;\n        padding: 1px 2px;\n        border-radius: 2px;\n    }\n</style>\n\n<div class=\"thermal-wrapper\">\n    {% set cmp = frappe.get_doc(\"Company\", doc.company) %}\n    {% set delivery_item_code = frappe.db.get_single_value('Cen CRM Settings', 'delivery_charge_item') %}\n    \n    <div class=\"thermal-header\">\n        <div class=\"thermal-company\">{{ cmp.company_name }}</div>\n        <div class=\"thermal-title\">PACKING SLIP</div>\n    </div>\n    \n    <div class=\"thermal-meta\">\n        <div class=\"meta-row\">\n            <span><b>To:</b> {{ doc.customer_name }}</span>\n        </div>\n        <div class=\"meta-row\">\n            <span><b>ID:</b> {{ doc.customer }}</span>\n            <span><b>Ph:</b> {{ doc.contact_mobile or doc.contact_display or 'N/A' }}</span>\n        </div>\n        <div class=\"meta-row\">\n            <span><b>Mode:</b> {{ doc.custom_mode_of_delivery or 'N/A' }}</span>\n        </div>\n        \n        {% if doc.custom_mode_of_delivery == 'Courier' and doc.custom_delivery_partner %}\n            {% set p_name = frappe.db.get_value(\"Delivery Partner\", doc.custom_delivery_partner, \"partner_name\") or doc.custom_delivery_partner %}\n            <div class=\"meta-row\">\n                <span><b>Partner:</b> {{ p_name }}</span>\n            </div>\n        {% endif %}\n        \n        {% if doc.custom_mode_of_delivery == 'Courier' and (doc.custom_address_line_1 or doc.custom_delivery_city or doc.custom_delivery_state) %}\n            <div style=\"margin: 3px 0; padding-top: 3px; padding-bottom: 3px; border-top: 1px dotted #ccc; border-bottom: 1px dotted #ccc;\">\n                <b>Address:</b><br>\n                <span style=\"font-size: 10px; line-height: 1.1;\">\n                    {% if doc.custom_address_line_1 %}{{ doc.custom_address_line_1 }}<br>{% endif %}\n                    {% if doc.custom_address_line_2 %}{{ doc.custom_address_line_2 }}<br>{% endif %}\n                    {% if doc.custom_delivery_city or doc.custom_delivery_state %}{{ doc.custom_delivery_city }}{% if doc.custom_delivery_city and doc.custom_delivery_state %}, {% endif %}{{ doc.custom_delivery_state }}<br>{% endif %}\n                    {% if doc.custom_pincode or doc.custom_delivery_country %}{{ doc.custom_pincode }}{% if doc.custom_pincode and doc.custom_delivery_country %}, {% endif %}{{ doc.custom_delivery_country }}{% endif %}\n                </span>\n            </div>\n        {% endif %}\n        \n        <div class=\"meta-row\">\n            <span><b>Store:</b> {{ doc.set_warehouse or 'N/A' }}</span>\n        </div>\n        <div class=\"meta-row\">\n            <span><b>Date:</b> {{ doc.get_formatted(\"delivery_date\") }}</span>\n            <span><b>Time:</b> {{ (doc.custom_delivery_time | string)[:5] if doc.custom_delivery_time else 'N/A' }}</span>\n        </div>\n    </div>\n    \n    <div class=\"thermal-qr\">\n        {% if doc.custom_box_id %}\n        <div style=\"font-size: 16px; font-weight: 900; margin-bottom: 6px; border: 2px solid #000; padding: 4px; display: inline-block; letter-spacing: 1px;\">\n            BOX ID: {{ doc.custom_box_id }}\n        </div>\n        {% endif %}\n        <div style=\"font-size: 10px; margin-bottom: 2px;\">Order ID (Scan):</div>\n        <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=200x200&data={{ doc.name | urlencode }}\" style=\"width: 120px; height: 120px;\" alt=\"QR Code\">\n        <div style=\"font-weight: bold; margin-top: 4px; font-size: 13px; letter-spacing: 1px;\">{{ doc.name }}</div>\n    </div>\n\n    {% if doc.custom_packing_instructions %}\n    <div class=\"thermal-instructions\">\n        <div class=\"thermal-instructions-title\">Special Packing Instructions</div>\n        <div class=\"thermal-instructions-content\">\n            {{ doc.custom_packing_instructions | replace('\\n', '<br>') }}\n        </div>\n    </div>\n    {% endif %}\n    \n    <table class=\"thermal-table\">\n        <thead>\n            <tr>\n                <th width=\"15%\">SR</th>\n                <th width=\"65%\">ITEM</th>\n                <th width=\"20%\" style=\"text-align: right;\">QTY</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.items if row.item_code != delivery_item_code %}\n                {% set parent_index = loop.index %}\n                \n                {% set child_items = [] %}\n                {% if doc.packed_items %}\n                    {% for p_item in doc.packed_items %}\n                        {% if p_item.parent_detail_docname == row.name %}\n                            {% set _ = child_items.append(p_item) %}\n                        {% endif %}\n                    {% endfor %}\n                {% endif %}\n                \n                <tr>\n                    <td style=\"font-weight: bold;\">{{ parent_index }}</td>\n                    <td>\n                        <b>{{ row.item_name }}</b>\n                        {% if child_items|length > 0 %}\n                            <span class=\"bundle-badge\">BUNDLE</span>\n                        {% endif %}\n                        {% if row.item_code != row.item_name %}\n                            <br><span class=\"item-code\">{{ row.item_code }}</span>\n                        {% endif %}\n                    </td>\n                    <td style=\"text-align: right; font-weight: bold; font-size: 13px;\">\n                        {{ row.qty | round(2) }}\n                        <div style=\"font-size: 9px; font-weight: normal;\">{{ row.uom }}</div>\n                    </td>\n                </tr>\n                \n                {% if child_items|length > 0 %}\n                    {% for c_item in child_items %}\n                    <tr>\n                        <td style=\"font-size: 10px; padding-left: 2px; color: #444;\">{{ parent_index }}.{{ loop.index }}</td>\n                        <td style=\"padding-left: 2px; font-size: 10px;\">\n                            <span style=\"color: #666;\">&#10551;</span> {{ c_item.item_name }}\n                        </td>\n                        <td style=\"text-align: right; font-size: 10px; font-weight: bold;\">\n                            {{ c_item.qty | round(2) }}\n                            <span style=\"font-size: 8px; font-weight: normal;\">{{ c_item.uom }}</span>\n                        </td>\n                    </tr>\n                    {% endfor %}\n                {% endif %}\n                \n            {% endfor %}\n        </tbody>\n    </table>\n</div>",
