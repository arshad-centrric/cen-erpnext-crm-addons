 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    /* Print-specific optimizations for Thermal Printers */\n    @media print {\n        @page {\n            size: 80mm auto;\n            margin: 0;\n        }\n        body {\n            margin: 0 !important;\n            padding: 0 !important;\n        }\n        .receipt-container {\n            color: #000000 !important;\n            text-rendering: optimizeLegibility !important;\n            -webkit-font-smoothing: antialiased;\n            margin: 0 auto !important;\n            padding: 0 !important;\n            width: 300px !important;\n            max-width: 300px !important;\n        }\n    }\n\n    .receipt-container {\n        width: 100%;\n        max-width: 300px;\n        font-family: 'Helvetica Neue', 'Arial', 'Helvetica', sans-serif; \n        font-size: 13px;\n        font-weight: 500;\n        color: #000000;\n        margin: 0 auto;\n        padding: 0;\n    }\n    \n    .text-center { text-align: center; }\n    .text-right { text-align: right; }\n    .text-left { text-align: left; }\n    .bold { font-weight: 700; }\n    \n    .dashed-line {\n        border-bottom: 1px dashed #000;\n        margin: 5px 0;\n    }\n    \n    table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n    \n    th, td {\n        padding: 0 !important; \n        margin: 0 !important;\n        line-height: 1.2 !important; \n    }\n    th { vertical-align: bottom; }\n    td { vertical-align: top; }\n    \n    /* Specific styles for the item table to improve visibility and prevent overlapping */\n    .item-table th, .item-table td {\n        font-size: 11px !important; /* Reduced font size just for items */\n        padding: 2px 0 !important;  /* Slight vertical padding for readability */\n    }\n\n    .clear { clear: both; }\n\n    /* Header & Titles */\n    .thermal-header {\n        text-align: center;\n        margin-bottom: 5px;\n        border-bottom: 1px dashed #000;\n        padding-bottom: 5px;\n    }\n    .thermal-company {\n        font-size: 16px;\n        font-weight: bold;\n        text-transform: uppercase;\n        margin-bottom: 2px;\n    }\n    .thermal-title {\n        font-size: 14px;\n        font-weight: bold;\n        letter-spacing: 1px;\n    }\n\n    /* Meta Details - CONDENSED */\n    .thermal-meta {\n        margin-bottom: 5px;\n        font-size: 11px;\n    }\n    .meta-row {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 1px; \n    }\n\n    /* QR Code */\n    .thermal-qr {\n        text-align: center;\n        margin: 8px 0;\n        padding: 8px 0;\n        border-top: 1px dashed #000;\n        border-bottom: 1px dashed #000;\n    }\n\n    /* Special Packing Instructions */\n    .thermal-instructions {\n        margin: 5px 0 8px 0;\n        padding: 4px;\n        border: 2px solid #000;\n        text-align: center;\n    }\n    .thermal-instructions-title {\n        font-size: 10px;\n        font-weight: 900;\n        text-transform: uppercase;\n        border-bottom: 1px solid #000;\n        margin-bottom: 3px;\n        display: inline-block;\n        padding-bottom: 1px;\n    }\n    .thermal-instructions-content {\n        font-size: 12px;\n        font-weight: bold;\n        line-height: 1.3;\n    }\n\n    /* Total Summary Box */\n    .thermal-totals {\n        display: flex;\n        justify-content: space-between;\n        border-bottom: 1px dashed #000;\n        padding: 4px 0;\n        margin-bottom: 10px;\n        font-weight: bold;\n        font-size: 13px;\n    }\n    \n    /* Bundle Badge & Delta Layout for Combo Items */\n    .bundle-badge {\n        font-size: 8px;\n        background: #000;\n        color: #fff;\n        padding: 1px 3px;\n        border-radius: 2px;\n        display: inline-block;\n        margin-top: 2px;\n        margin-bottom: 2px;\n    }\n    .thermal-delta-box {\n        margin-top: 4px;\n        padding-left: 2px;\n    }\n    .thermal-delta-heading {\n        font-size: 10px;\n        font-weight: bold;\n        color: #000;\n        margin-bottom: 2px;\n    }\n    .thermal-delta-item {\n        font-size: 10px;\n        color: #000;\n        line-height: 1.3;\n        margin-bottom: 2px;\n        padding-left: 2px;\n    }\n</style>\n\n<div class=\"receipt-container\">\n    \n    <!-- DETAILED HEADER -->\n    <div class=\"thermal-header\">\n        <div class=\"thermal-company\">AKBAR GULF TRADING</div>\n        <div class=\"thermal-title\">SALES ORDER</div>\n    </div>\n    \n    <div class=\"thermal-meta\">\n        <div class=\"meta-row\">\n            <span><b>To:</b> {{ doc.customer_name }}</span>\n        </div>\n        <div class=\"meta-row\">\n            <span><b>ID:</b> {{ doc.customer }}</span>\n            <span><b>Ph:</b> {{ doc.contact_mobile or doc.contact_display or 'N/A' }}</span>\n        </div>\n        <div class=\"meta-row\" style=\"margin-top: 3px; margin-bottom: 4px; padding-bottom: 4px; border-bottom: 1px dashed #000;\">\n            <span style=\"font-size: 11px; font-weight: bold;\">Del Ph: {{ doc.custom_delivery_contact or 'Same as Ph' }}</span>\n        </div>\n        <div class=\"meta-row\">\n            <span><b>Mode:</b> {{ doc.custom_mode_of_delivery or 'N/A' }}</span>\n        </div>\n        \n        {% if doc.custom_mode_of_delivery == 'Courier' and doc.custom_delivery_partner %}\n            {% set p_name = frappe.db.get_value(\"Delivery Partner\", doc.custom_delivery_partner, \"partner_name\") or doc.custom_delivery_partner %}\n            <div class=\"meta-row\">\n                <span><b>Partner:</b> {{ p_name }}</span>\n            </div>\n        {% endif %}\n        \n        {% if doc.custom_mode_of_delivery == 'Courier' and (doc.custom_address_line_1 or doc.custom_delivery_city or doc.custom_delivery_state) %}\n            <div style=\"margin: 3px 0; padding-top: 3px; padding-bottom: 3px; border-top: 1px dotted #ccc; border-bottom: 1px dotted #ccc;\">\n                <b>Address:</b><br>\n                <span style=\"font-size: 10px; line-height: 1.1;\">\n                    {% if doc.custom_address_line_1 %}{{ doc.custom_address_line_1 }}<br>{% endif %}\n                    {% if doc.custom_address_line_2 %}{{ doc.custom_address_line_2 }}<br>{% endif %}\n                    {% if doc.custom_delivery_city or doc.custom_delivery_state %}{{ doc.custom_delivery_city }}{% if doc.custom_delivery_city and doc.custom_delivery_state %}, {% endif %}{{ doc.custom_delivery_state }}<br>{% endif %}\n                    {% if doc.custom_pincode or doc.custom_delivery_country %}{{ doc.custom_pincode }}{% if doc.custom_pincode and doc.custom_delivery_country %}, {% endif %}{{ doc.custom_delivery_country }}{% endif %}\n                </span>\n            </div>\n        {% endif %}\n        \n        <div class=\"meta-row\">\n            <span><b>Store:</b> {{ doc.set_warehouse or 'N/A' }}</span>\n        </div>\n        <div class=\"meta-row\">\n            <span><b>Date:</b> {{ doc.get_formatted(\"delivery_date\") }}</span>\n            <span><b>Time:</b> \n                {% if doc.custom_delivery_time %}\n                    {% set time_str = doc.custom_delivery_time | string %}\n                    {% set h = time_str.split(':')[0] | int %}\n                    {% set m = time_str.split(':')[1] %}\n                    \n                    {% set h12 = h % 12 %}\n                    {% if h12 == 0 %}\n                        {% set h12 = 12 %}\n                    {% endif %}\n                    \n                    {% if h >= 12 %}\n                        {% set ampm = 'PM' %}\n                    {% else %}\n                        {% set ampm = 'AM' %}\n                    {% endif %}\n                    \n                    {{ \"%02d:%s %s\" | format(h12, m, ampm) }}\n                {% else %}\n                    N/A\n                {% endif %}\n            </span>\n        </div>\n    </div>\n    \n    <!-- BOX ID & QR CODE -->\n    <div class=\"thermal-qr\">\n        {% if doc.custom_box_id %}\n        <div style=\"font-size: 16px; font-weight: 900; margin-bottom: 6px; border: 2px solid #000; padding: 4px; display: inline-block; letter-spacing: 1px;\">\n            BOX ID: {{ doc.custom_box_id }}\n        </div>\n        {% endif %}\n        <div style=\"font-size: 10px; margin-bottom: 2px;\">Order ID (Scan):</div>\n        <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=200x200&data={{ doc.name | urlencode }}\" style=\"width: 120px; height: 120px;\" alt=\"QR Code\">\n        <div style=\"font-weight: bold; margin-top: 4px; font-size: 13px; letter-spacing: 1px;\">{{ doc.name }}</div>\n    </div>\n\n    {% if doc.custom_packing_instructions %}\n    <div class=\"thermal-instructions\">\n        <div class=\"thermal-instructions-title\">Special Packing Instructions</div>\n        <div class=\"thermal-instructions-content\">\n            {{ doc.custom_packing_instructions | replace('\\n', '<br>') }}\n        </div>\n    </div>\n    {% endif %}\n    \n    <!-- ORIGINAL ITEMS TABLE STYLE WITH COMBO LOGIC INJECTED -->\n    <table class=\"item-table\" cellpadding=\"0\" cellspacing=\"0\" style=\"table-layout: fixed; width: 100%; border-collapse: collapse; border-spacing: 0; margin-top: 5px;\">\n        <tr style=\"border-bottom: 1px dashed #000;\">\n            <!-- Adjusted widths to prevent overlapping -->\n            <th class=\"text-left\" style=\"width: 7%;\">#</th>\n            <th class=\"text-left\" style=\"width: 37%;\">Description</th>\n            <th class=\"text-right\" style=\"width: 14%;\">Qty</th>\n            <th class=\"text-right\" style=\"width: 21%;\">Rate</th>\n            <th class=\"text-right\" style=\"width: 21%;\">Total</th>\n        </tr>\n        \n        {%- for item in doc.items -%}\n        <tr>\n            <td>{{ loop.index }}</td>\n            <td style=\"word-wrap: break-word; padding-right: 2px !important;\">\n                {{ item.item_name }}\n                \n                <!-- CUSTOM BUNDLE BADGE -->\n                {% if item.custom_is_customized_bundle %}\n                    <br><span class=\"bundle-badge\">CUSTOM BUNDLE</span>\n                {% endif %}\n                \n                <!-- CUSTOMIZED BUNDLE CALCULATION LOGIC -->\n                {% if item.custom_is_customized_bundle and item.custom_original_bundle_item %}\n                    {% set base_items_raw = frappe.get_all(\"Product Bundle Item\", filters={\"parent\": item.custom_original_bundle_item}, fields=[\"item_code\", \"qty\"]) %}\n                    {% set custom_items_raw = frappe.get_all(\"Product Bundle Item\", filters={\"parent\": item.item_code}, fields=[\"item_code\", \"qty\"]) %}\n                    \n                    {% set base_map = {} %}\n                    {% for b in base_items_raw %}\n                        {% set _ = base_map.update({b.item_code: b.qty}) %}\n                    {% endfor %}\n                    \n                    {% set custom_map = {} %}\n                    {% for c in custom_items_raw %}\n                        {% set _ = custom_map.update({c.item_code: c.qty}) %}\n                    {% endfor %}\n                    \n                    {% set all_keys = [] %}\n                    {% for k in base_map.keys() %}{% set _ = all_keys.append(k) %}{% endfor %}\n                    {% for k in custom_map.keys() %}{% if k not in all_keys %}{% set _ = all_keys.append(k) %}{% endif %}{% endfor %}\n                    \n                    {% set additions = [] %}\n                    {% set cancellations = [] %}\n                    \n                    {% for k in all_keys %}\n                        {% set b_qty = base_map.get(k, 0) | float %}\n                        {% set c_qty = custom_map.get(k, 0) | float %}\n                        {% set diff = c_qty - b_qty %}\n                        \n                        {% set item_name_disp = frappe.db.get_value(\"Item\", k, \"item_name\") or k %}\n                        \n                        {% if diff > 0 %}\n                            {% set _ = additions.append({\"name\": item_name_disp, \"qty\": diff}) %}\n                        {% elif diff < 0 %}\n                            {% set _ = cancellations.append({\"name\": item_name_disp, \"qty\": diff | abs}) %}\n                        {% endif %}\n                    {% endfor %}\n                    \n                    <!-- DISPLAY DELTAS -->\n                    {% if additions or cancellations %}\n                    <div class=\"thermal-delta-box\">\n                        {% if cancellations %}\n                            <div class=\"thermal-delta-heading\">Cancelled:</div>\n                            {% for cancel in cancellations %}\n                                <div class=\"thermal-delta-item\">&bull; {{ cancel.name }} <b>(-{{ cancel.qty | round(2) }})</b></div>\n                            {% endfor %}\n                        {% endif %}\n                        \n                        {% if additions %}\n                            <div class=\"thermal-delta-heading\" style=\"margin-top: 4px;\">Added:</div>\n                            {% for add in additions %}\n                                <div class=\"thermal-delta-item\">&bull; {{ add.name }} <b>(+{{ add.qty | round(2) }})</b></div>\n                            {% endfor %}\n                        {% endif %}\n                    </div>\n                    {% endif %}\n                {% endif %}\n            </td>\n            <td class=\"text-right\">{{ \"{:,.2f}\".format(item.qty) }}</td>\n            <td class=\"text-right\">{{ \"{:,.2f}\".format(item.rate) }}</td>\n            <td class=\"text-right\">{{ \"{:,.2f}\".format(item.amount) }}</td>\n        </tr>\n        {%- endfor -%}\n    </table>\n    \n    <div class=\"dashed-line\"></div>\n    \n    <!-- TOTALS SUMMARY SECTION -->\n    <div class=\"thermal-totals\">\n        <span>Total Line Items: {{ doc.items | length }}</span>\n        <span>Total Amount: {{ doc.get_formatted(\"grand_total\") }}</span>\n    </div>\n\n    <div style=\"height: 35px; text-align: center; padding-top: 5px;\">\n        <span style=\"font-size: 9px; text-transform: uppercase; letter-spacing: 1px; color: #555;\">\n            ******\n        </span>\n    </div>\n    <div style=\"height: 40px; width: 100%;\"></div>\n</div>",
