 "doc_type": "Quotation",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    /* Base Typography & Layout */\n    .print-format-custom {\n        font-family: inherit;\n        font-size: 11px;\n        color: #333;\n    }\n    .print-format-custom p, .print-format-custom h3, .print-format-custom h4 {\n        margin-top: 0;\n    }\n    \n    /* Address Formatting */\n    .address-format {\n        line-height: 1.4;\n        color: #444;\n    }\n    \n    /* Header Styles */\n    .pf-header {\n        margin-bottom: 20px;\n        border-bottom: 2px solid #333; \n        padding-bottom: 15px;\n    }\n    .company-name {\n        margin-bottom: 5px; \n        font-weight: bold;\n        color: #000;\n    }\n    \n    /* Document Title */\n    .document-title {\n        margin-bottom: 25px;\n        font-weight: bold; \n        letter-spacing: 3px; \n        color: #000;\n    }\n\n    /* Meta Info & Labels */\n    .meta-section {\n        margin-bottom: 25px;\n    }\n    .meta-label {\n        font-size: 13px; \n        font-weight: bold; \n        text-transform: uppercase;\n        color: #000;\n    }\n    .section-heading {\n        font-size: 11px;\n        font-weight: bold;\n        text-transform: uppercase;\n        color: #555;\n        margin-bottom: 8px;\n        display: block;\n    }\n\n    /* Table Styles */\n    .print-format-custom .table {\n        margin-bottom: 20px;\n        border-collapse: collapse;\n        width: 100%;\n    }\n    .print-format-custom .table td, \n    .print-format-custom .table th {\n        padding: 8px 6px; \n        vertical-align: middle;\n        font-size: 11px;\n        border: 1px solid #cccccc !important;\n    }\n    .print-format-custom .table th {\n        background-color: #f7f7f7 !important; \n        font-weight: bold !important;\n        text-transform: uppercase;\n        color: #333;\n        font-size: 10px;\n    }\n    \n    .table-center th, .table-center td {\n        text-align: center;\n    }\n    \n    /* Item Specifics */\n    .item-name {\n        text-transform: uppercase; \n        font-size: 10px;\n        font-weight: bold;\n        color: #000;\n    }\n    .item-code {\n        font-size: 9px; \n        color: #777;\n    }\n    \n    /* Footer & Totals */\n    .totals-table {\n        width: 100%; \n        border-collapse: collapse;\n    }\n    .totals-table td {\n        padding: 4px 0;\n    }\n    .grand-total-row td {\n        padding-top: 8px !important;\n    }\n    .grand-total-row h4 {\n        margin: 0; \n        font-weight: bold;\n        color: #000;\n    }\n    .footer-note {\n        font-size: 11px; \n        color: #777; \n        margin-top: 40px; \n        border-top: 1px solid #eee; \n        padding-top: 15px;\n    }\n</style>\n\n<div class=\"print-format-custom\">\n    {% set cmp = frappe.get_doc(\"Company\", doc.company) %}\n    \n    <div class=\"row pf-header\">\n        <div class=\"col-xs-8\">\n            <h3 class=\"company-name\">{{ cmp.company_name }}</h3>\n            \n            {% set c_addr_list = frappe.get_all(\"Address\", filters={\"is_your_company_address\": 1}, fields=[\"address_line1\", \"address_line2\", \"city\", \"state\", \"pincode\", \"country\"], limit=1) %}\n            {% if c_addr_list %}\n                {% set c_addr = c_addr_list[0] %}\n                <div class=\"address-format\">\n                    {% if c_addr.address_line1 %}{{ c_addr.address_line1 }}<br>{% endif %}\n                    {% if c_addr.address_line2 %}{{ c_addr.address_line2 }}<br>{% endif %}\n                    {% if c_addr.city or c_addr.state %}{{ c_addr.city }}{% if c_addr.city and c_addr.state %}, {% endif %}{{ c_addr.state }}<br>{% endif %}\n                    {% if c_addr.pincode or c_addr.country %}{{ c_addr.pincode }}{% if c_addr.pincode and c_addr.country %}, {% endif %}{{ c_addr.country }}{% endif %}\n                </div>\n            {% endif %}\n        </div>\n        <div class=\"col-xs-4 text-right\">\n            {% if cmp.company_logo %}\n               <img src=\"{{ cmp.company_logo }}\" style=\"max-height: 70px; object-fit: contain;\">\n            {% endif %}\n        </div>\n    </div>\n    \n    <div class=\"text-center document-title\">\n        <h3 style=\"margin: 0;\">QUOTATION</h3>\n    </div>\n    \n    <div class=\"row meta-section\">\n        <div class=\"col-xs-7\">\n            <div style=\"color: #555; margin-bottom: 3px;\">Quotation For:</div>\n            <span class=\"meta-label\">{{ doc.customer_name }}</span><br>\n            \n            {% if doc.customer_address %}\n                {% set cust_addr = frappe.get_doc(\"Address\", doc.customer_address) %}\n                <div class=\"address-format\" style=\"margin-top: 3px;\">\n                    {% if cust_addr.address_line1 %}{{ cust_addr.address_line1 }}<br>{% endif %}\n                    {% if cust_addr.address_line2 %}{{ cust_addr.address_line2 }}<br>{% endif %}\n                    {% if cust_addr.city or cust_addr.state %}{{ cust_addr.city }}{% if cust_addr.city and cust_addr.state %}, {% endif %}{{ cust_addr.state }}<br>{% endif %}\n                    {% if cust_addr.pincode or cust_addr.country %}{{ cust_addr.pincode }}{% if cust_addr.pincode and cust_addr.country %}, {% endif %}{{ cust_addr.country }}{% endif %}\n                </div>\n            {% elif doc.address_display %}\n                <div style=\"margin-top: 3px;\">{{ doc.address_display }}</div>\n            {% endif %}\n            \n            <div style=\"margin-top: 5px;\">\n            {% if doc.contact_mobile %}\n               <b>Mobile:</b> {{ doc.contact_mobile }}\n            {% elif doc.contact_display %}\n               <b>Contact:</b> {{ doc.contact_display }}\n            {% endif %}\n            </div>\n        </div>\n        <div class=\"col-xs-5 text-right\">\n            <table style=\"width: 100%; border-collapse: collapse;\">\n                <tr>\n                    <td style=\"text-align: right; color: #555; padding-right: 10px;\">Quotation No:</td>\n                    <td style=\"text-align: right; font-weight: bold; color: #000;\">{{ doc.name }}</td>\n                </tr>\n                <tr>\n                    <td style=\"text-align: right; color: #555; padding-right: 10px; padding-top: 4px;\">Date:</td>\n                    <td style=\"text-align: right; font-weight: bold; color: #000; padding-top: 4px;\">{{ doc.get_formatted(\"transaction_date\") }}</td>\n                </tr>\n            </table>\n        </div>\n    </div>\n    \n    {% if doc.opportunity %}\n        {% set opp = frappe.db.get_value(\"Opportunity\", doc.opportunity, [\"custom_delivery_store\", \"custom_mode_of_delivery\", \"custom_delivery_date\", \"custom_delivery_time\"], as_dict=True) %}\n        \n        {% if opp and (opp.custom_delivery_store or opp.custom_mode_of_delivery or opp.custom_delivery_date) %}\n        <div style=\"margin-bottom: 25px;\">\n            <span class=\"section-heading\">Delivery Details</span>\n            <table class=\"table table-center\">\n                <thead>\n                    <tr>\n                        <th width=\"25%\">Delivery Date</th>\n                        <th width=\"25%\">Time</th>\n                        <th width=\"25%\">Store</th>\n                        <th width=\"25%\">Mode</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <td>{{ frappe.format(opp.custom_delivery_date, {'fieldtype': 'Date'}) if opp.custom_delivery_date else '' }}</td>\n                        <td>{{ (opp.custom_delivery_time | string)[:5] if opp.custom_delivery_time else '' }}</td>\n                        <td>{{ opp.custom_delivery_store if opp.custom_delivery_store else '' }}</td>\n                        <td>{{ opp.custom_mode_of_delivery if opp.custom_mode_of_delivery else '' }}</td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n        {% endif %}\n    {% endif %}\n    \n    <span class=\"section-heading\">Order Summary</span>\n    <table class=\"table\">\n        <thead>\n            <tr>\n                <th width=\"5%\" class=\"text-center\">SR</th>\n                <th width=\"45%\" style=\"text-align: left;\">ITEM DESCRIPTION</th>\n                <th width=\"15%\" class=\"text-right\">QUANTITY</th>\n                <th width=\"15%\" class=\"text-right\">RATE</th>\n                <th width=\"20%\" class=\"text-right\">AMOUNT</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.items %}\n            <tr>\n                <td class=\"text-center\">{{ loop.index }}</td>\n                <td>\n                    <span class=\"item-name\">{{ row.item_name }}</span>\n                    {% if row.item_code != row.item_name %}\n                    <br><span class=\"item-code\">{{ row.item_code }}</span>\n                    {% endif %}\n                </td>\n                <td class=\"text-right\">{{ row.qty | round(2) }} {{ row.uom }}</td>\n                <td class=\"text-right\">{{ row.get_formatted(\"rate\") }}</td>\n                <td class=\"text-right\">{{ row.get_formatted(\"amount\") }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <div class=\"row\">\n        <div class=\"col-xs-7\">\n            <div style=\"background-color: #fbfbfb; border: 1px solid #eee; padding: 10px; margin-top: 5px;\">\n                <span style=\"font-size: 10px; color: #777; text-transform: uppercase;\">Amount in words</span><br>\n                <span style=\"font-size: 11px; font-weight: bold; color: #333;\">{{ doc.in_words }}</span>\n            </div>\n        </div>\n        <div class=\"col-xs-5 text-right\">\n            <table class=\"totals-table\">\n                <tr>\n                    <td style=\"color: #555;\">Net Total:</td>\n                    <td style=\"text-align: right; font-weight: bold;\">{{ doc.get_formatted(\"net_total\") }}</td>\n                </tr>\n                {% if doc.total_taxes_and_charges > 0 %}\n                <tr>\n                    <td style=\"color: #555;\">Taxes:</td>\n                    <td style=\"text-align: right; font-weight: bold;\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td>\n                </tr>\n                {% endif %}\n                <tr>\n                    <td colspan=\"2\"><hr style=\"margin: 8px 0; border-top: 1px solid #ccc;\"></td>\n                </tr>\n                <tr class=\"grand-total-row\">\n                    <td><h4>Grand Total:</h4></td>\n                    <td style=\"text-align: right;\"><h4>{{ doc.get_formatted(\"grand_total\") }}</h4></td>\n                </tr>\n            </table>\n        </div>\n    </div>\n    \n    <div class=\"text-center footer-note\">\n        <p style=\"margin: 0; font-weight: bold; color: #555;\">Thank you for your business!</p>\n        {% if cmp.phone_no %}\n            <p style=\"margin: 4px 0 0 0;\">If you have any questions about this quotation, please contact us at: <b style=\"color: #333;\">{{ cmp.phone_no }}</b></p>\n        {% endif %}\n    </div>\n</div>",
 "idx": 0,
