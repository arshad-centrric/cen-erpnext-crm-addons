 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    /* Base Typography & Layout */\n    .print-format-custom {\n        font-family: inherit;\n        font-size: 11px;\n        color: #000;\n    }\n    .print-format-custom p, .print-format-custom h3, .print-format-custom h4 {\n        margin-top: 0;\n    }\n    \n    /* Header Styles */\n    .pf-header {\n        margin-bottom: 15px;\n        border-bottom: 2px solid #000; \n        padding-bottom: 5px; \n        margin-left: 0; \n        margin-right: 0;\n    }\n    .company-name {\n        margin-bottom: 0px; \n        font-weight: bold;\n        font-size: 18px; \n        text-transform: uppercase;\n        line-height: 1;\n    }\n    \n    /* Document Title */\n    .document-title {\n        margin-bottom: 15px;\n        font-weight: 900; \n        letter-spacing: 3px; \n        font-size: 20px;\n        text-align: center;\n        text-transform: uppercase;\n    }\n\n    /* Meta Info Box - 3 COLUMNS */\n    .meta-section {\n        margin-bottom: 10px;\n        border: 1px solid #000 !important;\n        padding: 10px;\n        border-radius: 2px;\n        overflow: hidden; \n    }\n    .meta-label {\n        font-size: 13px; \n        font-weight: bold; \n        text-transform: uppercase;\n    }\n    \n    /* QR Code Wrapper */\n    .qr-wrapper {\n        text-align: right;\n    }\n\n    /* Tear-off Line - UPDATED (Line Only) */\n    .tear-line {\n        border-top: 2px dashed #666;\n        margin: 15px 0 20px 0;\n    }\n\n    /* Packing Instructions Box */\n    .packing-instructions-box {\n        margin-bottom: 15px;\n        border: 2px solid #000;\n        padding: 10px;\n        background-color: #fcfcfc;\n    }\n    .packing-instructions-title {\n        font-size: 11px; \n        font-weight: 900; \n        text-transform: uppercase; \n        margin-bottom: 5px;\n        display: inline-block;\n        border-bottom: 1px solid #000;\n    }\n    .packing-instructions-content {\n        font-size: 13px; \n        font-weight: bold; \n        line-height: 1.4;\n    }\n\n    /* Table Styles - CONDENSED */\n    .print-format-custom .table {\n        margin-bottom: 15px;\n        border-collapse: collapse;\n        width: 100%;\n    }\n    .print-format-custom .table td, \n    .print-format-custom .table th {\n        padding: 4px 6px; \n        vertical-align: middle;\n        font-size: 11px;\n        border: 1px solid #000 !important; \n    }\n    .print-format-custom .table th {\n        background-color: #f5f5f5 !important; \n        font-weight: bold !important;\n        text-transform: uppercase;\n        text-align: center;\n    }\n    \n    .item-name {\n        font-size: 11px;\n        font-weight: bold;\n    }\n    .item-code {\n        font-size: 9px; \n        color: #444;\n    }\n    \n    /* Combo Indicator */\n    .combo-badge {\n        font-size: 9px; \n        color: #d9534f; \n        border: 1px solid #d9534f; \n        padding: 1px 4px; \n        border-radius: 2px;\n        margin-left: 5px;\n        vertical-align: middle;\n    }\n\n    /* Checkbox for physical picking */\n    .checkbox-box {\n        width: 16px;\n        height: 16px;\n        border: 1.5px solid #000;\n        margin: 0 auto;\n    }\n    \n    .checkbox-box-child {\n        width: 12px;\n        height: 12px;\n        border: 1px solid #000;\n        margin: 0 auto;\n    }\n\n    /* The Spacer Hack for wkhtmltopdf */\n    .pdf-spacer {\n        height: 80px; \n        width: 100%;\n        clear: both;\n    }\n\n    /* Signatures */\n    .signature-section {\n        page-break-inside: avoid;\n        clear: both; \n    }\n    .signature-line {\n        border-top: 1px solid #000;\n        width: 80%;\n        padding-top: 5px;\n        font-weight: bold;\n        text-align: center;\n    }\n</style>\n\n<div class=\"print-format-custom\">\n    {% set cmp = frappe.get_doc(\"Company\", doc.company) %}\n    \n    {% set delivery_item_code = frappe.db.get_single_value('Cen CRM Settings', 'delivery_charge_item') %}\n    \n    <div class=\"row pf-header\">\n        <div class=\"col-xs-8\" style=\"padding-top: 20px;\">\n            <h3 class=\"company-name\">{{ cmp.company_name }}</h3>\n        </div>\n        <div class=\"col-xs-4 text-right\">\n            {% if cmp.company_logo %}\n               <img src=\"{{ frappe.utils.get_url(cmp.company_logo) }}\" style=\"max-height: 70px; object-fit: contain;\">\n            {% endif %}\n        </div>\n    </div>\n    \n    <div class=\"document-title\">\n        PACKING SLIP\n    </div>\n    \n    <div class=\"meta-section\">\n        <div class=\"row\" style=\"margin: 0;\">\n            <div class=\"col-xs-4\" style=\"padding-left: 0;\">\n                <div style=\"margin-bottom: 8px;\">\n                    <span style=\"color: #333;\">Customer:</span><br>\n                    <span class=\"meta-label\">{{ doc.customer_name }}</span><br>\n                    <span style=\"font-size: 10px; color: #444; font-weight: bold;\">ID: {{ doc.customer }}</span><br>\n                    <span style=\"font-size: 10px; color: #444; font-weight: bold;\">Phone: {{ doc.contact_mobile or doc.contact_display or 'N/A' }}</span>\n                </div>\n                \n                {% if doc.custom_mode_of_delivery == 'Courier' and (doc.custom_address_line_1 or doc.custom_delivery_city or doc.custom_delivery_state) %}\n                <div style=\"margin-top: 8px; padding-top: 5px; border-top: 1px dotted #ccc;\">\n                    <span style=\"color: #555; font-size: 9px; text-transform: uppercase; font-weight: bold;\">Address:</span><br>\n                    <span style=\"font-size: 11px; font-weight: bold; line-height: 1.3;\">\n                        {% if doc.custom_address_line_1 %}{{ doc.custom_address_line_1 }}<br>{% endif %}\n                        {% if doc.custom_address_line_2 %}{{ doc.custom_address_line_2 }}<br>{% endif %}\n                        {% if doc.custom_delivery_city or doc.custom_delivery_state %}{{ doc.custom_delivery_city }}{% if doc.custom_delivery_city and doc.custom_delivery_state %}, {% endif %}{{ doc.custom_delivery_state }}<br>{% endif %}\n                        {% if doc.custom_pincode or doc.custom_delivery_country %}{{ doc.custom_pincode }}{% if doc.custom_pincode and doc.custom_delivery_country %}, {% endif %}{{ doc.custom_delivery_country }}{% endif %}\n                    </span>\n                </div>\n                {% endif %}\n            </div>\n            \n            <div class=\"col-xs-5\">\n                <div style=\"margin-bottom: 8px;\">\n                    <span style=\"color: #333;\">Delivery Contact:</span><br>\n                    <span style=\"font-size: 13px; font-weight: bold;\">{{ doc.custom_delivery_contact or doc.contact_mobile or doc.contact_display or 'N/A' }}</span>\n                </div>\n                <div style=\"margin-bottom: 8px;\">\n                    <span style=\"color: #333;\">Delivery Mode:</span><br>\n                    <span style=\"font-size: 13px; font-weight: bold;\">{{ doc.custom_mode_of_delivery or 'N/A' }}</span>\n                </div>\n                \n                {% if doc.custom_mode_of_delivery == 'Courier' and doc.custom_delivery_partner %}\n                {% set p_name = frappe.db.get_value(\"Delivery Partner\", doc.custom_delivery_partner, \"partner_name\") or doc.custom_delivery_partner %}\n                <div style=\"margin-bottom: 8px;\">\n                    <span style=\"color: #333;\">Courier Partner:</span><br>\n                    <span style=\"font-size: 13px; font-weight: bold;\">{{ p_name }}</span>\n                </div>\n                {% endif %}\n                \n                <div style=\"margin-bottom: 8px;\">\n                    <span style=\"color: #333;\">Delivery Store:</span><br>\n                    <span style=\"font-size: 13px; font-weight: bold;\">{{ doc.set_warehouse or 'N/A' }}</span>\n                </div>\n                <div>\n                    <span style=\"color: #333;\">Date & Time:</span><br>\n                    <span style=\"font-size: 13px; font-weight: bold;\">{{ doc.get_formatted(\"delivery_date\") }} | {{ (doc.custom_delivery_time | string)[:5] if doc.custom_delivery_time else 'N/A' }}</span>\n                </div>\n            </div>\n\n            <div class=\"col-xs-3 qr-wrapper\" style=\"padding-right: 0;\">\n                {% if doc.custom_box_id %}\n                <div style=\"color: #000; margin-bottom: 5px; font-weight: 900; font-size: 12px;\">BOX ID: {{ doc.custom_box_id }}</div>\n                {% endif %}\n                <div style=\"color: #333; margin-bottom: 3px; font-size: 10px;\">Order ID (Scan):</div>\n                <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={{ doc.name | urlencode }}\" style=\"height: 80px; width: 80px; border: 1px solid #000; padding: 2px;\" alt=\"QR Code\">\n                <div style=\"font-weight: bold; margin-top: 3px; font-size: 12px;\">{{ doc.name }}</div>\n            </div>\n            \n        </div>\n    </div>\n    \n    <div class=\"tear-line\"></div>\n\n    {% if doc.custom_packing_instructions %}\n    <div class=\"packing-instructions-box\">\n        <div class=\"packing-instructions-title\">Special Packing Instructions</div>\n        <div class=\"packing-instructions-content\">\n            {{ doc.custom_packing_instructions | replace('\\n', '<br>') }}\n        </div>\n    </div>\n    {% endif %}\n    \n    <table class=\"table\">\n        <thead>\n            <tr>\n                <th width=\"5%\">SR</th>\n                <th width=\"65%\" style=\"text-align: left;\">ITEM TO PICK</th>\n                <th width=\"15%\">QTY</th>\n                <th width=\"15%\">PICKED (\u2714)</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.items if row.item_code != delivery_item_code %}\n            \n                {% set child_items = [] %}\n                {% if doc.packed_items %}\n                    {% for p_item in doc.packed_items %}\n                        {% if p_item.parent_detail_docname == row.name %}\n                            {% set _ = child_items.append(p_item) %}\n                        {% endif %}\n                    {% endfor %}\n                {% endif %}\n                \n                <tr>\n                    <td class=\"text-center\" style=\"font-weight: bold;\">{{ loop.index }}</td>\n                    <td>\n                        <span class=\"item-name\">{{ row.item_name }}</span>\n                        {% if child_items|length > 0 %}\n                            <span class=\"combo-badge\">COMBO BUNDLE</span>\n                        {% endif %}\n                        \n                        {% if row.item_code != row.item_name %}\n                        <br><span class=\"item-code\">Code: {{ row.item_code }}</span>\n                        {% endif %}\n                        {% if row.description and row.description != row.item_name %}\n                        <br><span style=\"font-size: 9px; color: #555;\">{{ row.description | striptags }}</span>\n                        {% endif %}\n                    </td>\n                    <td class=\"text-center\" style=\"font-size: 12px; font-weight: bold;\">\n                        {{ row.qty | round(2) }} <span style=\"font-size: 9px; font-weight: normal; color: #333;\">{{ row.uom }}</span>\n                    </td>\n                    <td class=\"text-center\">\n                        <div class=\"checkbox-box\"></div>\n                    </td>\n                </tr>\n                \n                {% if child_items|length > 0 %}\n                    {% for c_item in child_items %}\n                    <tr style=\"background-color: #fafbfc;\">\n                        <td></td> <td style=\"padding-left: 20px;\">\n                            <span style=\"color: #888;\">&#10551;</span> \n                            <span class=\"item-name\" style=\"font-size: 10px;\">{{ c_item.item_name }}</span>\n                            {% if c_item.item_code != c_item.item_name %}\n                            &nbsp;<span class=\"item-code\">({{ c_item.item_code }})</span>\n                            {% endif %}\n                        </td>\n                        <td class=\"text-center\" style=\"font-size: 11px; font-weight: bold;\">\n                            {{ c_item.qty | round(2) }} <span style=\"font-size: 8px; font-weight: normal; color: #333;\">{{ c_item.uom }}</span>\n                        </td>\n                        <td class=\"text-center\">\n                            <div class=\"checkbox-box-child\"></div>\n                        </td>\n                    </tr>\n                    {% endfor %}\n                {% endif %}\n                \n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <div class=\"pdf-spacer\"></div>\n    \n    <div class=\"row signature-section\">\n        <div class=\"col-xs-6\">\n            <div class=\"signature-line\">Picked By</div>\n        </div>\n        <div class=\"col-xs-6\">\n            <div class=\"signature-line\" style=\"float: right;\">Date / Time</div>\n        </div>\n    </div>\n</div>",
 "idx": 0,
