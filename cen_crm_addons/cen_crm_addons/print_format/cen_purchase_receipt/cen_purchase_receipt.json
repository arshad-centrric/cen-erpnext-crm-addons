 "font_size": 14,
 "html": "<style>\n    /* Base Typography & Layout */\n    .print-format-custom {\n        font-family: inherit;\n        font-size: 11px;\n        color: #000;\n    }\n    .print-format-custom p, .print-format-custom h3, .print-format-custom h4 {\n        margin-top: 0;\n    }\n    \n    /* Header Styles */\n    .pf-header {\n        margin-bottom: 15px;\n        border-bottom: 2px solid #000; \n        padding-bottom: 5px; \n        margin-left: 0; \n        margin-right: 0;\n    }\n    .company-name {\n        margin-bottom: 0px; \n        font-weight: bold;\n        font-size: 18px; \n        text-transform: uppercase;\n        line-height: 1;\n    }\n    \n    /* Document Title */\n    .document-title {\n        margin-bottom: 5px;\n        font-weight: 900; \n        letter-spacing: 2px; \n        font-size: 20px;\n        text-align: center;\n        text-transform: uppercase;\n    }\n    .doc-name {\n        font-size: 14px;\n        font-weight: bold;\n        text-align: center;\n        margin-bottom: 15px;\n        color: #333;\n    }\n\n    /* Meta Info Box */\n    .meta-section {\n        margin-bottom: 15px;\n        border: 1px solid #000 !important;\n        padding: 8px 12px;\n        border-radius: 2px;\n        overflow: hidden; \n    }\n    \n    /* Table Styles */\n    .print-format-custom .table {\n        margin-bottom: 15px;\n        border-collapse: collapse;\n        width: 100%;\n    }\n    .print-format-custom .table td, \n    .print-format-custom .table th {\n        padding: 6px; \n        vertical-align: middle;\n        font-size: 11px;\n        border: 1px solid #000 !important; \n    }\n    .print-format-custom .table th {\n        background-color: #f5f5f5 !important; \n        font-weight: bold !important;\n        text-align: center;\n    }\n    \n    .item-name {\n        font-weight: bold;\n    }\n</style>\n\n<div class=\"print-format-custom\">\n    {% set cmp = frappe.get_doc(\"Company\", doc.company) %}\n    \n    <!-- Header -->\n    <div class=\"row pf-header\">\n        <div class=\"col-xs-8\" style=\"padding-top: 15px;\">\n            <h3 class=\"company-name\">{{ cmp.company_name }}</h3>\n        </div>\n        <div class=\"col-xs-4 text-right\">\n            {% if cmp.company_logo %}\n               <img src=\"{{ cmp.company_logo }}\" style=\"max-height: 60px; object-fit: contain;\">\n            {% endif %}\n        </div>\n    </div>\n    \n    <!-- Title & ID -->\n    <div class=\"document-title\">PURCHASE RECEIPT</div>\n    <div class=\"doc-name\">{{ doc.name }}</div>\n    \n    <!-- Meta Section -->\n    <div class=\"meta-section\">\n        <div class=\"row\">\n            <div class=\"col-xs-7\">\n                <table style=\"width: 100%; font-size: 11.5px;\">\n                    <tr>\n                        <td style=\"width: 120px; color: #444;\">Supplier Name:</td>\n                        <td style=\"font-weight: bold;\">{{ doc.supplier_name }}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"color: #444;\">Date:</td>\n                        <td style=\"font-weight: bold;\">{{ doc.get_formatted(\"posting_date\") }}</td>\n                    </tr>\n                    {% if doc.contact_mobile %}\n                    <tr>\n                        <td style=\"color: #444;\">Mobile No:</td>\n                        <td style=\"font-weight: bold;\">{{ doc.contact_mobile }}</td>\n                    </tr>\n                    {% endif %}\n                </table>\n            </div>\n            <div class=\"col-xs-5 text-right\">\n                <table style=\"width: 100%; font-size: 11.5px; text-align: right;\">\n                    <tr>\n                        <td style=\"color: #444;\">Reference No:</td>\n                        <td style=\"font-weight: bold;\">{{ doc.supplier_delivery_note or 'N/A' }}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"color: #444;\">Accepted Warehouse:</td>\n                        <td style=\"font-weight: bold;\">{{ doc.set_warehouse or 'N/A' }}</td>\n                    </tr>\n                </table>\n            </div>\n        </div>\n    </div>\n    \n    <!-- Items Table -->\n    <table class=\"table\">\n        <thead>\n            <tr>\n                <th width=\"5%\">Sr</th>\n                <th width=\"15%\" style=\"text-align: left;\">Item Code</th>\n                <th width=\"35%\" style=\"text-align: left;\">Description</th>\n                <th width=\"10%\">Accepted<br>Quantity</th>\n                <th width=\"10%\">UOM</th>\n                <th width=\"12%\" class=\"text-right\">Rate</th>\n                <th width=\"13%\" class=\"text-right\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% set totals = namespace(qty=0) %}\n            {% for row in doc.items %}\n                {% set totals.qty = totals.qty + row.qty %}\n                <tr>\n                    <td class=\"text-center\" style=\"font-weight: bold;\">{{ loop.index }}</td>\n                    <td>{{ row.item_code }}</td>\n                    <td>\n                        <span class=\"item-name\">{{ row.item_name }}</span>\n                        {% if row.description and row.description != row.item_name %}\n                            <br><span style=\"font-size: 9px; color: #555;\">{{ row.description | striptags }}</span>\n                        {% endif %}\n                    </td>\n                    <td class=\"text-center\" style=\"font-size: 12px; font-weight: bold;\">{{ row.qty | round(2) }}</td>\n                    <td class=\"text-center\">{{ row.uom }}</td>\n                    <td class=\"text-right\">{{ row.get_formatted(\"rate\") }}</td>\n                    <td class=\"text-right\" style=\"font-weight: bold;\">{{ row.get_formatted(\"amount\") }}</td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <!-- Totals Area -->\n    <div class=\"row\">\n        <!-- Total Quantity (Left Side) -->\n        <div class=\"col-xs-6\" style=\"vertical-align: top;\">\n            <div style=\"border: 1px solid #000; padding: 6px 12px; font-weight: bold; background-color: #f5f5f5; display: inline-block; text-transform: uppercase; margin-top: 0; vertical-align: top;\">\n                Total Quantity: {{ doc.total_qty or totals.qty }}\n            </div>\n        </div>\n        \n        <!-- Financial Totals (Right Side) -->\n        <div class=\"col-xs-6 text-right\" style=\"vertical-align: top;\">\n            <table class=\"table\" style=\"margin-top: 0;\">\n                <tbody>\n                    <tr>\n                        <td style=\"font-weight: bold;\">Total</td>\n                        <td class=\"text-right\" style=\"font-weight: bold;\">{{ doc.get_formatted(\"total\") }}</td>\n                    </tr>\n                    {% if doc.total_taxes_and_charges %}\n                    <tr>\n                        <td style=\"font-weight: bold;\">Taxes & Charges</td>\n                        <td class=\"text-right\" style=\"font-weight: bold;\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td>\n                    </tr>\n                    {% endif %}\n                    <tr>\n                        <td style=\"font-weight: 900; font-size: 12px;\">Grand Total</td>\n                        <td class=\"text-right\" style=\"font-weight: 900; font-size: 12px;\">{{ doc.get_formatted(\"grand_total\") }}</td>\n                    </tr>\n                    {% if doc.rounded_total %}\n                    <tr>\n                        <td style=\"font-weight: bold; color: #444;\">Rounded Total</td>\n                        <td class=\"text-right\" style=\"font-weight: bold; color: #444;\">{{ doc.get_formatted(\"rounded_total\") }}</td>\n                    </tr>\n                    {% endif %}\n                    <tr>\n                        <td colspan=\"2\" style=\"font-size: 10px; text-align: left;\">\n                            <span style=\"color: #555;\">In Words:</span> <strong>{{ doc.in_words }}</strong>\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n    </div>\n</div>",
 "idx": 0,
 "line_breaks": 0,
